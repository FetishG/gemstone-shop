<!DOCTYPE html>
<html>
<head>
    <style>
        body { background-color: black; color: white; font-family: sans-serif; margin: 0; padding: 0; }

        #landing-page { 
            height: 100vh; 
            width: 100%;
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            background-color: black; 
        }

        #landing-page img { max-width: 300px; height: auto; display: block; }

        #gallery-page { display: none; padding: 20px; }
        
        .grid { 
            display: grid; 
            /* This makes the grid cards smaller and more compact */
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); 
            gap: 15px; 
            max-width: 1000px;
            margin: 0 auto;
        }

        .stone-card { 
            background-color: #1a1a1a; 
            padding: 10px; 
            border: 1px solid #333; 
            border-radius: 8px; 
            text-align: center;
        }
        
        /* This forces images to be smaller and contain the whole view */
        .stone-card img { 
            width: 100%; 
            height: 140px; 
            object-fit: contain; 
            background-color: #000;
            border-radius: 4px; 
        }

        button { 
            padding: 15px 40px; 
            font-size: 20px; 
            cursor: pointer; 
            background-color: #b22222; 
            color: white; 
            border: none; 
            border-radius: 50px; 
            margin-top: 20px;
        }
    </style>
</head>

<body>
    <div id="landing-page">
        <img src="logo.png" alt="Logo">
        <button onclick="enterSite()">Enter Collection</button>
    </div>

    <div id="gallery-page">
        <div class="grid">
            </div>
    </div>

    <script>
        function enterSite() {
            document.getElementById('landing-page').style.display = 'none';
            document.getElementById('gallery-page').style.display = 'block';
        }
    </script>
</body>
</html>

